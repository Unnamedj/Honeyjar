# Railway inyecta DATABASE_URL solo con agregar el plugin de Postgres al proyecto.
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Secreto para firmar las cookies de sesion. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si cambia, se cierran todas las sesiones abiertas (los tokens de bot siguen valiendo).
SESSION_SECRET=cambiame-por-algo-largo-y-aleatorio

# Railway define PORT solo. En local, 3000.
PORT=3000

# Cada cuanto le decimos al bot que mande su heartbeat (ms).
# Mas bajo = dashboard mas en vivo, mas requests. 5000 es un buen punto.
BEAT_INTERVAL_MS=5000

# Dejalo en 0 para cerrar el registro una vez que se anotaron los que tenian que anotarse.
ALLOW_SIGNUP=1


# ══════════════════════════════════════════════════════════════════════════════
# FETCHER — el pool de servers para el auto-hop
# ══════════════════════════════════════════════════════════════════════════════
# El panel scrapea el listado de servers en segundo plano y le reparte jobIds a
# cada cuenta. Sin esto, cada bot pagina games.roblox.com por su cuenta cada vez
# que quiere saltar: con varias cuentas eso es rate-limit garantizado, y encima
# todas leen la misma primera pagina, asi que saltan al mismo server.
#
# Lista de proxies, separados por coma o salto de linea. Formatos aceptados:
#   user:pass@host:puerto      http://user:pass@host:puerto
#   host:puerto:user:pass      user:pass:host:puerto      host:puerto
#
# Con proxies residenciales tipo Nettify, el id de sesion que va DENTRO del
# usuario (…-session-XXXX-…) es lo que fija la IP de salida. El fetcher lo rota
# solo en cada request, asi que un unico proxy ya te da una IP distinta por
# request y el rate-limit nunca se acumula. NO hace falta pegar 50 lineas.
#
# PROXIES=0fphvc-country-SG-session-aub815-time-1:x7526zfdu9fd@eu.nettify.xyz:8080

# Alternativa: un archivo con un proxy por linea (se suma a PROXIES).
# PROXY_FILE=proxies.txt

# El fetcher arranca solo si hay proxies. FETCHER=1 lo fuerza sin ellos (todo
# sale por la IP de Railway: sirve para probar, se come 429 al rato).
# FETCHER=0 lo apaga siempre; los bots vuelven a hopear por su cuenta.
# FETCHER=1

# Place id del juego que se scrapea (Steal a Brainrot por defecto).
# FETCH_PLACE_ID=109983668079237

# Cuantos jugadores puede tener un server para contar como "chico".
# FETCH_MAX_PLAYERS=2

# Loops de scraping en paralelo. Con sesiones rotativas escala casi lineal;
# sin proxies, mas workers solo aceleran el rate-limit.
# FETCH_WORKERS=6

# Cuanto queda reservado un jobId ya entregado antes de volver a la rueda (ms).
# FETCH_RECYCLE_MS=90000

# Cuanto vale un jobId desde que se lo vio en el listado (ms). Mas viejo que
# esto ya se lleno y mandar un bot ahi es gastarle un teleport.
# FETCH_STALE_MS=480000
